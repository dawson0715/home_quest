# Copy to deploy/docker/.env on the server (never commit it) and fill in every secret.
DOMAIN=homequest.deplot.xyz

# MySQL (the app connects as DB_USER)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=homequest
MYSQL_USER=homequest
MYSQL_PASSWORD=change-me-app
DB_NAME=homequest
DB_USER=homequest
DB_PASSWORD=change-me-app

# Random string (e.g. `openssl rand -hex 32`)
COOKIE_KEY=change-me

# Web push: `docker compose -f docker-compose.prod.yml run --rm app php yii push/generate-keys`
VAPID_SUBJECT=mailto:info@deplot.xyz
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Weekly email (empty DSN = emails written to runtime/mail inside the container)
MAILER_DSN=
MAILER_FROM=noreply@homequest.deplot.xyz

# AI menu suggestions (Google Gemini, PAID tier only). Empty = local algorithm.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# prevent directory listings, follow symbolic links
Options -Indexes +FollowSymlinks

RewriteEngine On
RewriteCond %{REQUEST_URI} (wp-includes|wordpress|\.env)
RewriteRule ^ /403? [L,R=301]

# add the trailing slash on the original URL for directory requests,
# before the internal rewrite exposes /web/ in the redirect target
RewriteCond %{REQUEST_URI} !^/web/
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}/web%{REQUEST_URI} -d
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

RewriteCond %{REQUEST_URI} !^/web/
RewriteRule ^(.*)$ web/$1 [L]


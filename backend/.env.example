# Production settings: copy to backend/.env on the server (never commit it).
# One KEY=value per line, read by config/env.php (web and console).
HQ_ENV=prod

# Local MySQL on the server ("localhost" = unix socket)
DB_HOST=localhost
DB_NAME=homequest
DB_USER=homequest
DB_PASSWORD=change-me

# Random string: openssl rand -hex 32
COOKIE_KEY=change-me

# Web push: php yii push/generate-keys (or put the keys in config/params-local.php)
VAPID_SUBJECT=mailto:info@deplot.xyz
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Weekly email (empty DSN = emails written to runtime/mail)
MAILER_DSN=
MAILER_FROM=noreply@homequest.deplot.xyz

# AI menu suggestions (Google Gemini, PAID tier only: the free tier may not serve EU users).
# Empty key = suggestions computed locally, nothing is sent to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
